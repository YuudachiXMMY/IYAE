FROM python:3.12-slim

# Build tools required for libigl (C++ bindings compiled via CMake)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ cmake git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
# Rigging-specific deps (require C compiler)
RUN pip install --no-cache-dir libigl>=2.5.0 robust-laplacian>=1.0.0
# Pillow moved into requirements.txt — it is needed wherever textured GLBs are
# read, not just here.

COPY . .

ENV RIGGING_PROVIDER=python

CMD ["python", "main.py"]
