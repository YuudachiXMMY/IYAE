# Environment
.env
.env.*
!.env.example

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Java / Gradle (server)
server/build/
server/.gradle/
server/bin/
server/out/
*.class
*.jar
*.war

# Python (worker)
**/__pycache__/
**/*.pyc
worker/.venv/
worker/venv/
worker/*.egg-info/

# Node (web)
node_modules/

# Docker
docker-compose.override.yml

# Database backups (generated by dev.sh db backup)
backup_*.sql

# Production backups (generated by prod_deploy.sh backup, default BACKUP_DIR=./backups).
# These hold a full database dump — every customer's email, address, order history and body
# measurements in cleartext — plus an archive of the asset volume including body scans. The
# deployment host is a live git working tree (`prod_deploy.sh update` runs git pull), so without
# this rule a routine `git add -A` on that host would commit customer PII into the repository.
/backups/

# SSL certificates
letsencrypt/

# Logs
*.log

# Playwright / MCP
.playwright-mcp/
flow*.png
test-*.png
community-*.png
dashboard-*.png

# Claude Code / AI tooling
.claude/team-plan/
.claude/worktrees/

# SMPL-X model files — license forbids redistribution; fetch on demand.
# See smplx_models/README.md and scripts/fetch-smplx-models.sh
/smplx_models/*
!/smplx_models/README.md

# Rendered by `prod_deploy.sh ssl-init`. Generated deployment state must stay out of
# git: `update`'s rollback runs `git reset --hard`, which would discard it and silently
# drop the site back to plain HTTP.
nginx/conf.d/tls-active.conf
nginx/conf.d/*.http-only.bak

# The operator's real starter catalogue, for the same reason: it is per-deployment content, and
# `update`'s rollback would discard it. Only the example is tracked.
deploy/*.json
!deploy/catalog-seed.example.json
