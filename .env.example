# ============================================================
# IYAE — Local Development Environment
# ============================================================
#
# Quick Start:
#   1. cp .env.example .env
#   2. ./dev.sh setup          # validates prereqs, auto-generates JWT_SECRET
#   3. ./dev.sh start          # launches all 4 services (MySQL, Server, Worker, Web)
#   4. Open http://localhost:3000
#
# What you MUST change:
#   - MYSQL_ROOT_PASSWORD / DB_PASSWORD  (set strong passwords)
#   - JWT_SECRET is auto-generated by dev.sh setup — no manual action needed
#
# What you CAN leave as-is for local dev:
#   - AI_PROVIDER=mock          (no API keys needed)
#   - MODEL_GENERATION_PROVIDER=mock
#   - Email is a no-op unless RESEND_API_KEY is set (delivery failures are logged)
#   - All port defaults (3000/3001/3002)
#
# For production, see: ./prod_deploy.sh setup
# ============================================================

# ── Host Ports (fallback when Traefik is not running) ──────
WEB_PORT=3000
API_PORT=3001
DB_PORT=3002

# ── Database ─────────────────────────────────────────────
# Required: MySQL root password and app user password
MYSQL_ROOT_PASSWORD=changeme
DB_PASSWORD=changeme

# ── Security ─────────────────────────────────────────────
# Required: JWT signing secret (>=32 chars)
# Leave empty here — dev.sh setup auto-generates a secure value
JWT_SECRET=

# ── Application ──────────────────────────────────────────
# Spring profile controls logging and SQL output:
#   dev  — DEBUG logging, SQL queries printed (default)
#   prod — INFO logging, no SQL
#   test — H2 in-memory DB, Flyway disabled (used by JUnit, not here)
SPRING_PROFILES_ACTIVE=dev

# AI provider for conversational styling and outfit generation:
#   mock     — deterministic stub, no API key needed (default)
#   claude   — Anthropic Messages API (requires ANTHROPIC_API_KEY)
#   deepseek — OpenAI-compatible API (requires DEEPSEEK_API_KEY)
#   minimax  — CN endpoint api.minimaxi.com, model MiniMax-M2.7 (requires MINIMAX_API_KEY)
AI_PROVIDER=mock

# docker-compose appends http://localhost:${WEB_PORT} to this list, so changing
# WEB_PORT alone does not break browser writes. Add any other origin by hand.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://iyae.localhost

# ── AI Provider Keys (uncomment the one matching AI_PROVIDER) ────
# ANTHROPIC_API_KEY=              # claude
# DEEPSEEK_API_KEY=               # deepseek
# MINIMAX_API_KEY=                # minimax

# ── Worker / 3D Model Generation ─────────────────────────
# The Python worker polls MySQL for PENDING tasks and generates 3D models.
# Provider selection:
#   mock    — StubGenerator: creates minimal valid GLB (empty scene), no API needed (default)
#   tripo3d — Tripo3D API v2: creates task -> polls until success -> downloads GLB
#             Requires WORKER_TRIPO_API_KEY
#   meshy   — Meshy.ai API: creates task -> polls -> downloads GLB & USDZ
#             Requires WORKER_MESHY_API_KEY
MODEL_GENERATION_PROVIDER=mock
# WORKER_TRIPO_API_KEY=           # required when MODEL_GENERATION_PROVIDER=tripo3d
# WORKER_MESHY_API_KEY=           # required when MODEL_GENERATION_PROVIDER=meshy
# WORKER_POLL_INTERVAL=5          # seconds between task queue polls (default: 5)
# WORKER_OUTPUT_DIR=/var/iyae/assets  # generated GLB output path (default: /var/iyae/assets)

# Avatar generation provider:
#   mock  — placeholder humanoid GLB (default, no dependencies)
#   smplx — SMPL-X parametric body model (requires model data + torch)
AVATAR_GENERATION_PROVIDER=mock
# SMPLX_MODELS_PATH=./smplx_models  # host path to SMPL-X model files (mounted read-only into container)
# When using AVATAR_GENERATION_PROVIDER=smplx:
#   1. Download SMPL-X model files from https://smpl-x.is.tue.mpg.de/
#   2. Run 'git lfs pull' if models are tracked via Git LFS
#   3. Required Python packages: torch>=2.0.0, smplx>=0.1.28, trimesh>=4.0.0, numpy>=1.24.0

# ── Rigging Worker ────────────────────────────────────────────────
# Garment rigging provider:
#   mock    — StubRiggingProvider: placeholder rigged GLB (default for dev)
#   python  — PythonRiggingProvider: pure Python weight transfer (igl + robust_laplacian)
#   blender — BlenderRiggingProvider: Blender headless subprocess (legacy, requires Blender installed)
RIGGING_PROVIDER=mock
# BLENDER_PATH=blender         # Only needed when RIGGING_PROVIDER=blender
#
# Which task queues the default `worker` container claims from. `dev.sh start` always brings up
# the dedicated `rigging-worker` (RIGGING_PROVIDER=python) as well, so leaving the default worker
# on every role made the two race for the same rigging tasks — and whichever won decided whether
# a garment was rigged for real or with this container's `mock` stub output, both writing the
# same /assets/rigged/{id} path. Set to `model,avatar,rigging` only if you are running without
# the rigging profile. Production is deliberately different: one worker with every role.
# WORKER_ROLES=model,avatar

# ── Weather (AI stylist context, optional) ────────────────────────
# The AI stylist enriches recommendations with current Toronto weather from
# Open-Meteo (keyless, free). The cache is pre-warmed off the request path, so a
# slow/unreachable upstream never adds latency to a chat turn. All optional — the
# values below are the defaults baked into application.yml.
# WEATHER_ENABLED=true
# WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
# WEATHER_LATITUDE=43.6532
# WEATHER_LONGITUDE=-79.3832
# WEATHER_TIMEZONE=America/Toronto
# WEATHER_CACHE_TTL=1800        # Positive integer seconds; also the cache pre-warm cadence (floored at 1s; 0/non-numeric is invalid)

# ── Traefik Domains (optional, used when Traefik proxy is running) ─
# WEB_DOMAIN=iyae.localhost
# API_DOMAIN=api.iyae.localhost

# ── Mail ──────────────────────────────────────────────────────────
# Frontend base URL (used in email links, e.g. password reset)
FRONTEND_BASE_URL=http://localhost:3000

# NOTE: NEXT_PUBLIC_REQUIRE_EMAIL_VERIFICATION has been REMOVED — do not re-add it.
# The web client reads the gate from the server at runtime (GET /api/public/config),
# which reports app.auth.require-email-verification directly.
# The old build-time variable had no build-arg plumbing in web/Dockerfile, so the
# production image always inlined the default and could never send a new registrant to
# /verify-email/pending — every signup was bounced to a dashboard where nothing worked.
# Configure the gate on the server only; there is no second flag to keep in sync.

# ── Resend (sole transactional email path, via the Next.js API route) ─
# All email (verification, password reset) is sent through the Next.js internal
# route (/api/internal/mail/send), which renders the templates and calls the Resend
# SDK. The server never sends SMTP directly. Without RESEND_API_KEY, delivery fails
# and the failure is logged (registration / forgot-password still succeed).
# Get your API key at https://resend.com/api-keys
# Verify your sending domain at https://resend.com/domains
# RESEND_API_KEY=re_xxxxxxxxx

# Shared secret for server->web internal mail API calls
INTERNAL_MAIL_SECRET=
# Resend sender email address (use verified domain in production)
# Default onboarding@resend.dev is a sandbox — can only deliver to your Resend account email
RESEND_FROM_EMAIL=onboarding@resend.dev

# ── Administrator bootstrap (REQUIRED in production) ─────────────────
# Production has no other way to obtain an administrator: the seeder does not run under the
# prod profile, public registration rejects the ADMIN role, and no migration inserts one.
# Without these the /admin console and the user-report queue are reachable by nobody.
# On first boot the server promotes this account if it already exists, or creates it with the
# password below. It then no-ops on every later boot — it will not reset a live password.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
# This account also gets a designer profile, so it can create and publish listings and fill the
# FEATURED/SPONSORED promotion slots from /designer/products — the operator is the only account a
# fresh instance has, and nothing else can author a listing.

# ── Starter catalogue (strongly recommended on a fresh database) ──────
# A fresh production database has zero products: Flyway inserts no content and the dev seeder
# does not run under the prod profile. The result is a storefront that renders "No pieces found"
# for every visitor while every health signal reports fine — so `prod_deploy.sh health` now
# fails on an empty catalogue.
#
# Point this at a JSON manifest to have the server create those listings on boot under
# ADMIN_BOOTSTRAP_EMAIL, skipping any whose name is already there (safe on every restart; it
# never overwrites a listing you have since edited). Copy deploy/catalog-seed.example.json,
# replace the three placeholder listings with real ones, and keep it next to the example —
# ./deploy is mounted read-only at /etc/iyae/deploy, so the path below is the container's.
# Leave blank to seed nothing and enter the catalogue by hand instead.
CATALOG_SEED_MANIFEST=
# e.g. CATALOG_SEED_MANIFEST=/etc/iyae/deploy/catalog-seed.json

# ── Stripe (payment collection) — OFF for launch #1 ──────────────────
# Leaving both blank is the supported "no payment" configuration: POST /api/checkout
# and the resale buy-now path answer 503, and the web client hides both entry points.
# A blank key is NOT a silent free-order path any more (see app.payments.stub-checkout-enabled,
# which is pinned false outside dev/test).
#
# To enable payment later you must supply BOTH. STRIPE_SECRET_KEY on its own makes the
# webhook throw "Webhook secret not configured", which breaks fulfilment instead of
# enabling payment — prod_deploy.sh setup rejects that half-configured state.
# STRIPE_SECRET_KEY=sk_live_xxxxxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx
